<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base glass fill -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F211202D" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Top shine gradient -->
    <item android:top="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#1245A895"
                android:centerColor="#071B2C38"
                android:endColor="#00FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Border -->
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#FF30434E" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
