<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base glass -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#CC0A1120" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- Top shine -->
    <item android:top="1dp" android:left="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#22FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- Cyan accent border -->
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#3322D3EE" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
