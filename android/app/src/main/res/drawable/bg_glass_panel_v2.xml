<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#CC0D1526" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Top shine -->
    <item android:top="1dp" android:left="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#20FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Border -->
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="0.5dp" android:color="#26FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
