<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FF4D67">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="oval">
                    <solid android:color="#33FF4D67" />
                    <stroke android:width="2dp" android:color="#FFFF4D67" />
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <solid android:color="#1A0F1A30" />
                    <stroke android:width="2dp" android:color="#80FF4D67" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
