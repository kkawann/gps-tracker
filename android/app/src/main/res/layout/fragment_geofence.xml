<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep">

    <org.osmdroid.views.MapView
        android:id="@+id/mapGeofence"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Hint pill (top) -->
    <TextView
        android:id="@+id/tvGeofenceHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_signal_pill"
        android:text="برای افزودن حصار، روی نقشه ضربه بزنید"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:fontFamily="@font/vazirmatn_semi_bold"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:elevation="3dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="14dp"
        android:layout_marginTop="60dp"
        android:background="@drawable/bg_surface_card"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:text="محدوده‌های من"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:fontFamily="@font/vazirmatn_semi_bold"
        android:elevation="3dp" />

    <!-- FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddGeofence"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="20dp"
        android:src="@drawable/ic_add"
        android:contentDescription="افزودن حصار"
        style="@style/FabStyle" />

    <!-- ═══ فهرست حصارها (عمودی، بالا-چپ) — کلیک = پرتاب نقشه به حصار ═══ -->
    <LinearLayout
        android:id="@+id/geofenceChipList"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="12dp"
        android:layout_marginTop="100dp"
        android:orientation="vertical"
        android:maxWidth="220dp" />

    <!-- Geofence create/edit dialog — glass bottom sheet -->
    <ScrollView
        android:id="@+id/dialogGeofence"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_glass_float"
        android:padding="22dp"
        android:layout_margin="12dp"
        android:elevation="10dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDialogTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="حصار جدید"
                android:textColor="@color/aurora_cyan"
                android:textSize="16sp"
                android:fontFamily="@font/vazirmatn_bold"
                android:layout_marginBottom="14dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="نام حصار"
                android:layout_marginBottom="12dp"
                style="@style/InputDark">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etGeofenceName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:fontFamily="@font/vazirmatn_medium"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="شعاع (متر)"
                android:layout_marginBottom="10dp"
                style="@style/InputDark">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etGeofenceRadius"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:fontFamily="@font/vazirmatn_medium"
                    android:inputType="number"
                    android:text="500" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="محدودیت سرعت داخل حصار (km/h) - 0 = بدون"
                android:layout_marginBottom="14dp"
                style="@style/InputDark">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etGeofenceSpeedLimit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:fontFamily="@font/vazirmatn_medium"
                    android:inputType="number"
                    android:text="0" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ── هشدار خروج ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="هشدار خروج"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:fontFamily="@font/vazirmatn_semi_bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="وقتی از محدوده خارج شد"
                        android:textColor="@color/text_hint"
                        android:textSize="11sp"
                        android:fontFamily="@font/vazirmatn_medium" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchExitAlert"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:textOn=""
                    android:textOff=""
                    app:showText="false" />
            </LinearLayout>

            <!-- روش اطلاع‌رسانی خروج: تماس / پیامک -->
            <LinearLayout
                android:id="@+id/exitMethodRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="12dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="روش اطلاع‌رسانی"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:fontFamily="@font/vazirmatn_medium" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleExitMethod"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExitCall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="تماس"
                        android:textSize="12sp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExitSms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="پیامک"
                        android:textSize="12sp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
            </LinearLayout>

            <!-- ── هشدار ورود ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="هشدار ورود"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:fontFamily="@font/vazirmatn_semi_bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="وقتی وارد محدوده شد"
                        android:textColor="@color/text_hint"
                        android:textSize="11sp"
                        android:fontFamily="@font/vazirmatn_medium" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchEnterAlert"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:textOn=""
                    android:textOff=""
                    app:showText="false" />
            </LinearLayout>

            <!-- روش اطلاع‌رسانی ورود: تماس / پیامک -->
            <LinearLayout
                android:id="@+id/enterMethodRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="12dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="روش اطلاع‌رسانی"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:fontFamily="@font/vazirmatn_medium" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleEnterMethod"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEnterCall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="تماس"
                        android:textSize="12sp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEnterSms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="پیامک"
                        android:textSize="12sp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelGeofence"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="لغو"
                    android:textColor="@color/text_secondary"
                    android:fontFamily="@font/vazirmatn_medium"
                    style="@style/BtnText" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveGeofence"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ذخیره"
                    style="@style/BtnPrimary"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
