<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_deep">

    <!-- Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="تاریخچه سفر"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:fontFamily="@font/vazirmatn_bold"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="4dp" />

    <!-- Day selector chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/daySelectorContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Time range filter row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="از"
            android:textColor="@color/text_hint"
            android:textSize="12sp"
            android:fontFamily="@font/vazirmatn_medium"
            android:layout_marginEnd="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTimeFrom"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="00:00"
            android:textColor="@color/aurora_cyan"
            android:textSize="13sp"
            android:fontFamily="@font/vazirmatn_semi_bold"
            style="@style/BtnOutlined"
            app:cornerRadius="14dp"
            android:minWidth="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="تا"
            android:textColor="@color/text_hint"
            android:textSize="12sp"
            android:fontFamily="@font/vazirmatn_medium"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTimeTo"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="23:59"
            android:textColor="@color/aurora_cyan"
            android:textSize="13sp"
            android:fontFamily="@font/vazirmatn_semi_bold"
            style="@style/BtnOutlined"
            app:cornerRadius="14dp"
            android:minWidth="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApplyTimeFilter"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="اعمال"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:fontFamily="@font/vazirmatn_semi_bold"
            app:backgroundTint="@color/md_theme_primary"
            app:cornerRadius="14dp"
            android:minWidth="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />
    </LinearLayout>

    <!-- Stats grid — 4 aurora stat cards -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:baselineAligned="false">

        <!-- Distance -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_stat_card"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/tvDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="@color/aurora_cyan"
                android:textSize="17sp"
                android:fontFamily="@font/vazirmatn_bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="مسافت"
                android:textColor="@color/text_hint"
                android:textSize="10sp"
                android:fontFamily="@font/vazirmatn_medium"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Duration -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_stat_card"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/tvDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="@color/aurora_green"
                android:textSize="17sp"
                android:fontFamily="@font/vazirmatn_bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="مدت"
                android:textColor="@color/text_hint"
                android:textSize="10sp"
                android:fontFamily="@font/vazirmatn_medium"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Max speed -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_stat_card"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/tvMaxSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="@color/aurora_amber"
                android:textSize="17sp"
                android:fontFamily="@font/vazirmatn_bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="حداکثر"
                android:textColor="@color/text_hint"
                android:textSize="10sp"
                android:fontFamily="@font/vazirmatn_medium"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Avg speed -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_stat_card"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/tvAvgSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="@color/aurora_purple"
                android:textSize="17sp"
                android:fontFamily="@font/vazirmatn_bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="میانگین"
                android:textColor="@color/text_hint"
                android:textSize="10sp"
                android:fontFamily="@font/vazirmatn_medium"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Loading -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressBarHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/aurora_cyan"
        app:trackColor="@color/md_theme_surfaceVariant"
        app:trackCornerRadius="4dp" />

    <!-- Map -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapHistory"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp" />

</LinearLayout>
