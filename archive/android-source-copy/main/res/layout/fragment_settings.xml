<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_glass_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="تنظیمات"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:fontFamily="@font/vazirmatn_bold"
            android:layout_marginBottom="18dp" />

        <!-- ═══ Device info glass card ════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_glass_panel"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/viewDeviceDot"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="◈"
                android:textSize="20sp"
                android:textColor="@color/aurora_cyan"
                android:background="@drawable/bg_stat_card"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDeviceName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="نامشخص"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:fontFamily="@font/vazirmatn_semi_bold" />

                <TextView
                    android:id="@+id/tvDeviceId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="@font/vazirmatn_medium"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Owner + phones -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_stat_card"
                android:padding="12dp"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="شماره مالک"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp"
                    android:fontFamily="@font/vazirmatn_medium" />

                <TextView
                    android:id="@+id/tvOwnerPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:fontFamily="@font/vazirmatn_semi_bold"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_stat_card"
                android:padding="12dp"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="شماره‌های مجاز"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp"
                    android:fontFamily="@font/vazirmatn_medium" />

                <TextView
                    android:id="@+id/tvAuthorizedPhones"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 شماره"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:fontFamily="@font/vazirmatn_semi_bold"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ═══ Edit name ═════════════════════════════════════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="نام دستگاه"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:fontFamily="@font/vazirmatn_medium"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                style="@style/InputDark">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCustomName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:fontFamily="@font/vazirmatn_medium"
                    android:inputType="text"
                    android:hint="نام دستگاه"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ذخیره"
                style="@style/BtnPrimary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- ═══ Speed limit ═══════════════════════════════════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="محدودیت سرعت (km/h)"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:fontFamily="@font/vazirmatn_medium"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                style="@style/InputDark">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSpeedLimit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:fontFamily="@font/vazirmatn_medium"
                    android:inputType="number"
                    android:hint="0 = بدون محدودیت"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveSpeedLimit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ذخیره"
                style="@style/BtnPrimary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- ═══ Manage phones ═════════════════════════════════ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnManagePhones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="مدیریت شماره‌های مجاز"
            android:textColor="@color/aurora_cyan"
            android:textSize="13sp"
            android:fontFamily="@font/vazirmatn_medium"
            android:layout_marginBottom="16dp"
            style="@style/BtnOutlined"
            app:cornerRadius="18dp" />

        <!-- Phone dialog -->
        <LinearLayout
            android:id="@+id/phoneDialog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            style="@style/GlassCard"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="هر شماره در یک خط"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:fontFamily="@font/vazirmatn_medium"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etPhones"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:background="@color/md_theme_surfaceContainerLow"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:hint="09121111111&#10;09352222222"
                android:inputType="textMultiLine"
                android:padding="12dp"
                android:gravity="top"
                android:fontFamily="@font/vazirmatn_medium"
                android:textSize="14sp"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelPhones"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="لغو"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="@font/vazirmatn_medium"
                    style="@style/BtnText" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSavePhones"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ذخیره"
                    style="@style/BtnPrimary"
                    android:textSize="12sp"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ═══ Connection ════════════════════════════════════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="اتصال"
            android:textColor="@color/aurora_cyan"
            android:textSize="13sp"
            android:fontFamily="@font/vazirmatn_semi_bold"
            android:layout_marginBottom="8dp"
            android:layout_marginTop="8dp" />

        <!-- Server URL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:hint="آدرس سرور"
                style="@style/InputDark">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etServerUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:fontFamily="@font/vazirmatn_medium"
                    android:inputType="textUri"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveServerUrl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ذخیره"
                style="@style/BtnPrimary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- MQTT Broker URL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp"
            android:gravity="center_vertical">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:hint="آدرس MQTT Broker"
                style="@style/InputDark">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etBrokerUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:fontFamily="@font/vazirmatn_medium"
                    android:inputType="textUri"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveBrokerUrl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ذخیره"
                style="@style/BtnPrimary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ═══ Logout ════════════════════════════════════════ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="خروج از حساب"
            android:textColor="@color/aurora_red"
            android:textSize="14sp"
            android:fontFamily="@font/vazirmatn_medium"
            android:layout_marginBottom="32dp"
            style="@style/BtnOutlined"
            app:strokeColor="@color/aurora_red"
            app:cornerRadius="18dp" />

    </LinearLayout>
</ScrollView>
